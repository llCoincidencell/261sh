name: GitHub Pages ile Canlı Yayınla (PWA ve Web)

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Depoyu Klonla
        uses: actions/checkout@v4

      - name: Node.js Kurulumu
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Web Uygulamasını Derle ve GitHub Pages'e Hazırla
        run: |
          npm install --legacy-peer-deps
          npm run build
          
          # GitHub Pages'in _assets gibi klasörleri yok saymasını engelle
          touch dist/.nojekyll

      - name: GitHub Pages Yapılandır
        uses: actions/configure-pages@v5

      - name: Dağıtım Dosyalarını Yükle
        uses: actions/upload-pages-artifact@v3
        with:
          path: './dist'

      - name: GitHub Pages Canlı Yayına Al
        id: deployment
        uses: actions/deploy-pages@v4
